# Copy this file's contents into secrets/.env (gitignored) and fill in real values.
# A symlink at the project root, .env -> secrets/.env, is what Expo actually reads.

# Optional. Google Gemini free-tier key used to rewrite confirmed FDA label
# excerpts into plain language. The app works without it (falls back to
# deterministic text cleanup) — see lib/geminiClient.ts.
EXPO_PUBLIC_GEMINI_API_KEY=
